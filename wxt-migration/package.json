{
  "name": "abuu-start-extension",
  "description": "航启首页 · abuu-start · 更适合北航宝宝体质的浏览器启动页",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "relay": "node --experimental-strip-types ../server/index.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.5"
  }
}
